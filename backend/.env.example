# Local demo. DEBUG=True allows SQLite. Never ship this file to production.
DEBUG=True
DJANGO_ENV=development
DJANGO_SECRET_KEY=dev-only-change-in-prod-safiroute
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8877
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8877

# Production (DJANGO_ENV=production) refuses SQLite, wildcard hosts, and this dev secret.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=safiroute
# DB_USER=safiroute
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Encrypted backups. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store the key in the same secret store as DJANGO_SECRET_KEY. Losing it makes backups unreadable.
BACKUP_ENCRYPTION_KEY=
# BACKUP_DIR=/var/backups/safiroute

# Optional Azure Blob for media. Local demo keeps files on disk until these are set.
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# AZURE_CONTAINER=safiroute-media
# AZURE_CONNECTION_STRING=

# Optional Sentry. Leave empty — a stub DSN is not initialized.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
